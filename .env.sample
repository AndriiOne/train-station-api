# Copy this file to .env and fill in your own values:
#   cp .env.sample .env

# Django
SECRET_KEY=<your-secret-key>
DEBUG=True

# PostgreSQL
POSTGRES_PASSWORD=<your-db-password>
POSTGRES_USER=<your-db-user>
POSTGRES_DB=<your-db-name>
POSTGRES_HOST=db
POSTGRES_PORT=5432
PGDATA=/var/lib/postgresql/data
